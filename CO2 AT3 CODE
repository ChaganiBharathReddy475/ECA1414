#define TIMEOUT 1000

int sensor_ready(void)
{
    return 0;   // 0 = Sensor not responding
}

int main(void)
{
    int timeout = TIMEOUT;

    while (!sensor_ready())
    {
        timeout--;

        if (timeout == 0)
        {
            // Timeout occurred
            break;
        }
    }

    while (1)
    {
    }

    return 0;
}
